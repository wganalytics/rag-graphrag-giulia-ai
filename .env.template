# Neo4j Graph DB Config
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123

# ------------------------------------------------------------------
# Provider de LLM: ollama (local) | gemini | grok | groq
# Define o padrão do sistema. A interface permite trocar em tempo de execução.
# CUIDADO: 'grok' (xAI) e 'groq' (Groq Cloud) são empresas diferentes.
# ------------------------------------------------------------------
LLM_PROVIDER=groq

# --- Ollama (local, sem chave) ---
OLLAMA_BASE_URL=http://localhost:11434
ENGINE_MODEL_NAME=llama3.2:latest

# --- Google Gemini ---
# Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# --- xAI Grok ---
# Chave em https://console.x.ai
XAI_API_KEY=
GROK_MODEL_NAME=grok-4-latest

# --- Groq Cloud (inferência rápida de modelos abertos) ---
# Chave em https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile
